# devbox machine settings. Not secret: this file is in git and world-readable.
#
# provision/provision.sh installs this file as /etc/devbox/devbox.env. Your
# shell (~/.zshenv) and devbox services read it from there. To change a
# setting, edit this file in the repo, then run:
#   sudo ~/.devbox/src/provision/provision.sh --only config
#
# Format: KEY=value, one per line. No quotes, spaces or $ in values, so systemd
# (EnvironmentFile=) and the shell (set -a; . file) read exactly the same thing.
# Check it with: ds config

# Machine name on the tailnet.
DEVBOX_HOST=devbox
# The same file serves every devbox. The developer's account comes from
# provision.sh --user, and projects live in ~/projects. To override per machine,
# set DEVBOX_USER / DEVBOX_PROJECTS_DIR in the environment.

# Domains for the devbox and for apps running on it. DEVBOX_APPS_DOMAIN gives
# each project a name: a single word such as devbox means <project>.devbox over
# Tailscale (provision step "names"); a real domain means https.
DEVBOX_DOMAIN=
DEVBOX_APPS_DOMAIN=devbox
# internal: project links (and devbox, dbs.devbox) also answer on https, with
# certificates from the devbox's own CA (Caddy's tls internal); ds cert shows
# how to trust it on a laptop. Plain http keeps working, for phones. off: http only.
DEVBOX_APPS_TLS=internal

# Ports handed out to dev servers, inclusive.
DEVBOX_PORT_MIN=4100
DEVBOX_PORT_MAX=4999
# Port for Dozzle, the container log viewer. Keep it outside the range above.
DEVBOX_DOZZLE_PORT=9999

# What ds update follows: main (every change) or release (newest v* tag).
DEVBOX_CHANNEL=main

# Where ds publish puts a project that has no origin yet: github (a private
# repo under your gh login) or gitlab (a private project under your glab login,
# optionally mirrored to GitHub). Empty means github. Each developer can choose
# their own in ~/.devbox/config.env (DEVBOX_FORGE=gitlab).
DEVBOX_FORGE=github
